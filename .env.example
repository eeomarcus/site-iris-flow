# =====================================================================
# IrisFlow — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto. O .gitignore já ignora .env e .env.*, e abre exceção só para
# este .env.example, então os valores reais não sobem para o repositório.
#
#   cp .env.example .env.local
#
# Tudo que começa com VITE_ é embutido no bundle e fica visível para
# qualquer visitante do site. Não existe variável secreta aqui: se um
# valor não pode ser lido por estranhos, ele não entra neste arquivo.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL  -> VITE_SUPABASE_URL
#   anon public  -> VITE_SUPABASE_ANON_KEY
#
# A chave anônima é pública por definição: ela vai no JavaScript do site
# e todo mundo consegue lê-la. Quem protege os dados é a Row Level
# Security do supabase/schema.sql, não o segredo da chave.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public


# ---------------------------------------------------------------------
# ATENÇÃO: a service_role key NÃO entra aqui
#
# O painel do Supabase mostra, logo abaixo da anon, uma chave chamada
# service_role. Ela ignora toda a Row Level Security e dá acesso
# irrestrito ao banco. Prefixada com VITE_, ela seria publicada no
# bundle do site e qualquer pessoa poderia ler e apagar a base inteira.
#
# Ela só pode ser usada no servidor: Edge Functions do Supabase ou um
# back-end seu, onde vira variável de ambiente sem prefixo VITE_.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Gateway de pagamento (opcional enquanto o checkout for demonstração)
#
# Chave PÚBLICA do gateway, usada pelo SDK no navegador para tokenizar
# o cartão. É a contrapartida do tokenizeCard em src/services/api.ts.
# A chave privada fica no servidor, nunca aqui.
#
#   Stripe        -> publishable key (pk_...)
#   Mercado Pago  -> public key (APP_USR-...)
#   Pagar.me      -> encryption key (ek_...)
# ---------------------------------------------------------------------
VITE_PAYMENT_PUBLIC_KEY=


# ---------------------------------------------------------------------
# API própria (opcional)
#
# Só é necessária se você subir Edge Functions ou um back-end à parte
# para webhooks do gateway. Falando direto com o Supabase pelo
# supabase-js, pode ficar vazia.
# ---------------------------------------------------------------------
VITE_API_URL=
